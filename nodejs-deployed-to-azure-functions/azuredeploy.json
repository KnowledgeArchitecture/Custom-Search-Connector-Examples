{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "simplerssscraper",
      "metadata": {
        "description": "Base name for all resources. The function app name must be globally unique."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "connectorId": {
      "type": "string",
      "metadata": {
        "description": "Knowledge Architecture Connector ID (CONNECTOR_ID env var)."
      }
    },
    "apiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Knowledge Architecture API Key (API_KEY env var)."
      }
    },
    "category": {
      "type": "string",
      "metadata": {
        "description": "RSS feed category to scrape (CATEGORY env var). Either 'Newsletter' or 'Podcast'."
      }
    }
  },
  "variables": {
    "storageAccountName": "[concat('sa', uniqueString(resourceGroup().id))]",
    "hostingPlanName": "[concat(parameters('appName'), '-plan')]",
    "functionAppName": "[parameters('appName')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "kind": "functionapp",
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[variables('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "siteConfig": {
          "use32BitWorkerProcess": false,
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value, ';EndpointSuffix=core.windows.net')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~22"
            },
            {
              "name": "CONNECTOR_ID",
              "value": "[parameters('connectorId')]"
            },
            {
              "name": "API_KEY",
              "value": "[parameters('apiKey')]"
            },
            {
              "name": "CATEGORY",
              "value": "[parameters('category')]"
            },
            {
              "name": "RSS_SCRAPER_SCHEDULE",
              "value": "0 0 * * * *"
            },
            {
              "name": "PROJECT",
              "value": "nodejs-deployed-to-azure-functions"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/sourcecontrols",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('functionAppName'), '/web')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]"
      ],
      "properties": {
        "repoUrl": "https://github.com/KnowledgeArchitecture/Custom-Search-Connector-Examples.git",
        "branch": "separate-azure-functions-deploy",
        "isManualIntegration": true
      }
    }
  ],
  "outputs": {
    "functionAppUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', variables('functionAppName'))).defaultHostName)]"
    }
  }
}